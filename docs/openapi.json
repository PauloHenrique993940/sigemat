{
  "openapi": "3.0.3",
  "info": {
    "title": "SIGEMAT API",
    "version": "0.1.0",
    "description": "API de gestão de CICOMs, materiais, solicitações e entregas do SIGEMAT."
  },
  "servers": [{ "url": "http://localhost:3000", "description": "Desenvolvimento local" }],
  "tags": [
    { "name": "Dashboard", "description": "Indicadores operacionais" },
    { "name": "CICOMs", "description": "Unidades atendidas" },
    { "name": "Entregas", "description": "Registro e consulta de retiradas" }
  ],
  "paths": {
    "/api/dashboard": {
      "get": {
        "tags": ["Dashboard"],
        "summary": "Consulta os indicadores do painel",
        "responses": {
          "200": {
            "description": "Indicadores consolidados",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DashboardResponse" } } }
          },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      }
    },
    "/api/cicoms": {
      "get": {
        "tags": ["CICOMs"],
        "summary": "Lista CICOMs com paginação, busca e status",
        "parameters": [
          { "$ref": "#/components/parameters/Page" },
          { "$ref": "#/components/parameters/PerPage" },
          { "name": "q", "in": "query", "schema": { "type": "string" }, "description": "Busca por nome, código ou região" },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["ACTIVE", "INACTIVE"] } }
        ],
        "responses": {
          "200": { "description": "Lista paginada", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/PaginatedCicoms" } } } },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "post": {
        "tags": ["CICOMs"],
        "summary": "Cadastra um CICOM",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CicomInput" }, "example": { "name": "CICOM Salvador", "code": "CICOM-SSA", "region": "Leste", "municipality": "Salvador", "status": "ACTIVE" } } } },
        "responses": {
          "201": { "description": "CICOM criado", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CicomResponse" } } } },
          "409": { "description": "Código já cadastrado" },
          "422": { "$ref": "#/components/responses/ValidationError" }
        }
      }
    },
    "/api/deliveries": {
      "get": {
        "tags": ["Entregas"],
        "summary": "Lista entregas registradas",
        "parameters": [{ "$ref": "#/components/parameters/Page" }, { "$ref": "#/components/parameters/PerPage" }],
        "responses": { "200": { "description": "Lista paginada de entregas" }, "500": { "$ref": "#/components/responses/InternalError" } }
      },
      "post": {
        "tags": ["Entregas"],
        "summary": "Registra uma entrega",
        "description": "Valida estoque, evita duplicidade, atualiza a solicitação e grava auditoria.",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/DeliveryInput" } } } },
        "responses": {
          "201": { "description": "Entrega registrada" },
          "409": { "description": "Solicitação indisponível" },
          "422": { "description": "Payload inválido, item duplicado, item incompatível ou estoque insuficiente" }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "Page": { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
      "PerPage": { "name": "perPage", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 } }
    },
    "responses": {
      "ValidationError": { "description": "Dados inválidos" },
      "InternalError": { "description": "Erro interno do servidor" }
    },
    "schemas": {
      "CicomInput": { "type": "object", "required": ["name", "code"], "properties": { "name": { "type": "string", "minLength": 3, "maxLength": 120 }, "code": { "type": "string", "minLength": 2, "maxLength": 30 }, "region": { "type": "string", "nullable": true }, "municipality": { "type": "string", "nullable": true }, "address": { "type": "string", "nullable": true }, "responsible": { "type": "string", "nullable": true }, "phone": { "type": "string", "nullable": true }, "email": { "type": "string", "format": "email", "nullable": true }, "status": { "type": "string", "enum": ["ACTIVE", "INACTIVE"], "default": "ACTIVE" }, "notes": { "type": "string", "nullable": true } } },
      "CicomResponse": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/Cicom" } } },
      "Cicom": { "allOf": [{ "$ref": "#/components/schemas/CicomInput" }, { "type": "object", "required": ["id", "createdAt"], "properties": { "id": { "type": "string", "format": "uuid" }, "createdAt": { "type": "string", "format": "date-time" } } }] },
      "PaginatedCicoms": { "type": "object", "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/Cicom" } }, "meta": { "$ref": "#/components/schemas/PaginationMeta" } } },
      "PaginationMeta": { "type": "object", "properties": { "page": { "type": "integer" }, "perPage": { "type": "integer" }, "total": { "type": "integer" }, "pages": { "type": "integer" } } },
      "DashboardResponse": { "type": "object", "properties": { "data": { "type": "object", "properties": { "cicoms": { "type": "integer" }, "solicitations": { "type": "integer" }, "pendingSolicitations": { "type": "integer" }, "deliveries": { "type": "integer" }, "completed": { "type": "integer" }, "partial": { "type": "integer" }, "pendingItems": { "type": "integer" }, "lowStock": { "type": "integer" } } } } },
      "DeliveryInput": { "type": "object", "required": ["solicitationId", "attendantId", "attendantName", "items"], "properties": { "solicitationId": { "type": "string", "format": "uuid" }, "attendantId": { "type": "string", "format": "uuid" }, "attendantName": { "type": "string", "minLength": 2 }, "notes": { "type": "string" }, "deliveredAt": { "type": "string", "format": "date-time" }, "items": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["solicitationItemId", "amount"], "properties": { "solicitationItemId": { "type": "string", "format": "uuid" }, "amount": { "type": "number", "exclusiveMinimum": 0 } } } } } }
    }
  }
}
